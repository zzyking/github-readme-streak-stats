{
    "routes": [
        { "handle": "filesystem" },
        { "src": "/github-readme-streak-stats/demo/?", "dest": "/api/demo/index.php" },
        { "src": "/github-readme-streak-stats/demo/(.+)", "dest": "/api/demo/vercel-static.php" },
        { "src": "/github-readme-streak-stats/", "dest": "/api/index.php" },
    ],
    "rewrites": [
        { "source": "/github-readme-streak-stats(.*)", "destination": "/$1" }
    ],
    "functions": {
        "api/**/*": {
            "runtime": "vercel-php@0.7.3"
        }
    }
}
